generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline             Boolean   @default(false)
  scope               String?
  expires              DateTime?
  accessToken          String
  userId              BigInt?
  firstName            String?
  lastName             String?
  email                String?
  accountOwner         Boolean   @default(false)
  locale               String?
  collaborator         Boolean?  @default(false)
  emailVerified        Boolean?  @default(false)
  refreshToken         String?
  refreshTokenExpires  DateTime?
}

model Popup {
  id        String   @id @default(cuid())
  shop      String
  name      String
  status    String   @default("draft")
  priority  Int      @default(1)
  steps     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id                   String   @id @default(cuid())
  shop                 String
  name                 String
  description          String
  type                 String   @default("targeted")
  status               String   @default("draft")
  audience             String
  popupId              String?
  trigger              String
  triggerDelaySeconds  Int      @default(5)
  triggerScrollPercent Int      @default(50)
  pageTargetMode       String   @default("all")
  pageTargets          Json
  siteTargetMode       String   @default("all")
  siteTargets          Json     @default("[]")

  // How often one visitor may see this campaign.
  // "unlimited" (default), "once", or "limited" with frequencyLimit.
  frequencyMode        String   @default("unlimited")
  frequencyLimit       Int      @default(3)

  // Days before the popup may return to the same visitor after they
  // submit or close it. 0 means never show it to them again.
  // reshowDismissedDays defaults to 1, which is the cooldown the
  // widget used to hardcode.
  reshowCollectedDays  Int      @default(0)
  reshowDismissedDays  Int      @default(1)

  // Which device widths may see it: any of "desktop", "tablet",
  // "mobile". All three by default, so existing campaigns are
  // unaffected.
  devices              Json     @default("[\"desktop\", \"tablet\", \"mobile\"]")

  reward               String
  rewardDiscountId     String?
  rewardDiscountCode   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// A website the merchant runs campaigns on. The Shopify storefront
// itself is stored here too (kind = "shopify") so that every surface
// the widget can appear on is addressable from one place.
//
// "domain" is always a bare, lowercased hostname with no scheme, no
// port and no www prefix, so that what the browser reports and what
// the merchant typed compare equal.
model Site {
  id         String    @id @default(cuid())
  shop       String
  name       String
  domain     String
  kind       String    @default("external")
  autoAdded  Boolean   @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([shop, domain])
  @@index([shop])
}

model Contact {
  id         String   @id @default(cuid())
  shop       String
  popupId    String?
  popupName  String?
  campaignId String?
  email      String?
  phone      String?
  fields     Json
  pageUrl    String?
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
}

// One row per thing a popup did in a shopper's browser: it was shown,
// it was submitted, or it was closed. Nothing else in the app records
// impressions, so without this table a conversion rate cannot be
// calculated at all — Contacts only tells you about the people who
// said yes.
//
// Append-only. Rows are never updated, and the Analytics screen reads
// them by aggregating over a date window.
model PopupEvent {
  id         String   @id @default(cuid())
  shop       String
  campaignId String
  popupId    String?

  // "view" | "submit" | "dismiss"
  type       String

  // Which width bucket the shopper was in, so a merchant can see that
  // a campaign converts on desktop but not on mobile.
  device     String?

  // "shopify" for the theme app embed, "external" for a website
  // running the universal snippet.
  source     String   @default("shopify")

  pageUrl    String?
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, campaignId, type])
}

// One row per coupon we owe somebody. Created when a popup is
// submitted, then worked off separately, because a shopper should
// never wait on an SMTP handshake to see their success screen.
//
// Unlike PopupEvent this is not append-only: a row is updated as it
// is attempted, succeeds or gives up, which is what makes a retry
// possible and lets the merchant see who actually got their code.
model DiscountDelivery {
  id          String    @id @default(cuid())
  shop        String
  contactId   String
  campaignId  String

  // "email" for now. "whatsapp" slots in here without a migration.
  channel     String

  // The address or number as it was at the time. Kept separate from
  // Contact so editing or erasing a contact cannot rewrite history.
  destination String

  // Resolved from the campaign on the server. The browser never
  // sends a code, so it cannot ask for one it was not offered.
  code        String

  // "pending" | "sent" | "failed"
  status      String    @default("pending")
  attempts    Int       @default(0)
  error       String?

  // The provider's message id, so a bounce or delivery webhook can
  // be matched back to this row.
  providerId  String?

  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // A shopper who submits twice, or a retried request, must not be
  // sent two coupons.
  @@unique([contactId, channel])
  @@index([shop, status])
  @@index([shop, createdAt])
}
