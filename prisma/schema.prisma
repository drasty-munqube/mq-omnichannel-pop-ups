generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline             Boolean   @default(false)
  scope               String?
  expires              DateTime?
  accessToken          String
  userId              BigInt?
  firstName            String?
  lastName             String?
  email                String?
  accountOwner         Boolean   @default(false)
  locale               String?
  collaborator         Boolean?  @default(false)
  emailVerified        Boolean?  @default(false)
  refreshToken         String?
  refreshTokenExpires  DateTime?
}

model Popup {
  id        String   @id @default(cuid())
  shop      String
  name      String
  status    String   @default("draft")
  priority  Int      @default(1)
  steps     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id                   String   @id @default(cuid())
  shop                 String
  name                 String
  description          String
  type                 String   @default("targeted")
  status               String   @default("draft")
  audience             String
  popupId              String?
  trigger              String
  triggerDelaySeconds  Int      @default(5)
  triggerScrollPercent Int      @default(50)
  pageTargetMode       String   @default("all")
  pageTargets          Json
  siteTargetMode       String   @default("all")
  siteTargets          Json     @default("[]")
  reward               String
  rewardDiscountId     String?
  rewardDiscountCode   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// A website the merchant runs campaigns on. The Shopify storefront
// itself is stored here too (kind = "shopify") so that every surface
// the widget can appear on is addressable from one place.
//
// "domain" is always a bare, lowercased hostname with no scheme, no
// port and no www prefix, so that what the browser reports and what
// the merchant typed compare equal.
model Site {
  id         String    @id @default(cuid())
  shop       String
  name       String
  domain     String
  kind       String    @default("external")
  autoAdded  Boolean   @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([shop, domain])
  @@index([shop])
}

model Contact {
  id         String   @id @default(cuid())
  shop       String
  popupId    String?
  popupName  String?
  campaignId String?
  email      String?
  phone      String?
  fields     Json
  pageUrl    String?
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
}