node_modules

# macOS
.DS_Store

/.cache
/build
/app/build
/public/build/
/public/_dev
/app/public/build
/prisma/dev.sqlite
/prisma/dev.sqlite-journal
database.sqlite

.env
.env.*
# The example carries no values and has to stay committed, so it is
# pulled back out of the rule above. Order matters: the negation is
# only honoured after the pattern that ignored it.
!.env.example

# Other shapes a secret arrives in
*.pem
*.key
*.p12
*.pfx
service-account*.json
secrets/


/extensions/*/dist

# Ignore shopify files created during app dev
.shopify/*
.shopify.lock

# Hide files auto-generated by react router
.react-router/
# Claude Code local settings, per machine
.claude/settings.local.json
