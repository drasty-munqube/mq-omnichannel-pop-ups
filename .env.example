# Copy to .env and fill in. .env is gitignored and must stay that way.
#   cp .env.example .env

# ---------------------------------------------------------------
# SHOPIFY
# ---------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.onrender.com

# ---------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------------------------------------------------------------
# COUPON EMAIL
#
# The first configured option is used: Brevo, then Resend, then SMTP.
# Leave all of them empty and the app still runs; deliveries stay
# pending and say that email is not configured.
#
# Render's free plan blocks outbound SMTP (ports 25, 465, 587), so
# on Render use Brevo or Resend. They send over HTTPS.
#
# MAIL_FROM is the sender for every option.
# ---------------------------------------------------------------
MAIL_FROM="Your Store <you@yourdomain.com>"

# Option 1: Brevo (recommended, free 300 emails/day)
# brevo.com > Settings > SMTP & API > API Keys > Generate a new API key
# The MAIL_FROM address must be added and verified under
# Settings > Senders, Domains & Dedicated IPs > Senders.
BREVO_API_KEY=

# Option 2: Resend (needs your domain verified in Resend first)
RESEND_API_KEY=

# Option 3: SMTP (works locally or on a paid host, not on Render free)
# Gmail needs 2-Step Verification and an App Password from
# https://myaccount.google.com/apppasswords
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
