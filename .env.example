# Copy to .env and fill in. .env is gitignored and must stay that way.
#   cp .env.example .env

# ---------------------------------------------------------------
# SHOPIFY
# ---------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.onrender.com

# ---------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------------------------------------------------------------
# COUPON EMAIL (SMTP)
#
# Gmail: turn on 2-Step Verification first, then create an App
# Password at https://myaccount.google.com/apppasswords
# A normal Gmail password will not authenticate over SMTP.
#
# Leave these empty and the app still runs. Deliveries queue up and
# report that email is not configured, rather than crashing.
#
# Gmail's daily send cap is roughly 500 on a free account and 2000
# on Workspace. Past that, point these at Resend, SES or Postmark;
# only the values change.
# ---------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
MAIL_FROM="Your Store <you@yourdomain.com>"
